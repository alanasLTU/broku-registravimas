SUPABASE_SERVICE_ROLE_KEY=eyJ...



# Tiesioginis prisijungimas (dev / test): NODE_ENV !== production arba ALLOW_DIRECT_LOGIN=true

# ALLOW_DIRECT_LOGIN=true



# --- Resend (el. laiškai) ---

# 1) Sukurk API raktą: https://resend.com/api-keys

# 2) Patvirtink domeną (pvz. digroup.lt) Resend → Domains → Add → DNS TXT/MX

# 3) EMAIL_FROM turi būti iš to patvirtinto domeno, pvz. noreply@digroup.lt

# Lokaliam greitam testui (tik į savo Resend paskyros el. paštą):

#   RESEND_API_KEY=re_...

#   EMAIL_FROM=onboarding@resend.dev

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

EMAIL_FROM=Brokai <noreply@digroup.lt>



# Kas siunčia laiškus, kai abu kintamieji užpildyti:

# - Naujo vartotojo kvietimas (/admin/users)

# - Pranešimas projekto kontaktams (notify_email) per POST /api/email arba notifyResponsible kuriant įrašą

# - Dienos suvestinė (reikia ir CRON_SECRET žemiau)



# --- SF OCR (neprivaloma; be rakto — rankinis įvedimas) ---

# Pakanka vieno: OPENAI_API_KEY arba AI_GATEWAY_API_KEY

OPENAI_API_KEY=sk-...

# AI_GATEWAY_API_KEY=

# INVOICE_OCR_MODEL=gpt-4o-mini



# --- Dienos suvestinė (Vercel cron 07:00 UTC ≈ 10:00 LT) ---

# CRON_SECRET=



# Patikra: prisijungus GET /api/email → {"configured":true}

